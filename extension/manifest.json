{
  "manifest_version": 3,
  "name": "JackTrap",
  "version": "1.0.0",
  "description": "Per-site network artifact collection + in-page resource heuristics + VirusTotal signature lookups, focused on cryptojacking detection.",
  "permissions": ["webRequest", "tabs", "storage", "scripting", "activeTab", "alarms", "webNavigation", "system.cpu", "system.memory"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JackTrap",
    "default_icon": "jacktrap_ext.png"
  },
  "icons": {
    "16": "jacktrap_ext.png",
    "48": "jacktrap_ext.png",
    "32": "jacktrap_ext.png",
    "128": "jacktrap_ext.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_start"
    }
  ]
}
