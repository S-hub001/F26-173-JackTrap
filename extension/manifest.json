{
  "manifest_version": 3,
  "name": "JackTrap",
  "version": "1.1.0",
  "minimum_chrome_version": "111",
  "description": "Layered cryptojacking detection: system CPU, a static JavaScript scanner, in-page behavior, network artifacts and VirusTotal lookups.",
  "permissions": ["webRequest", "tabs", "storage", "scripting", "activeTab", "alarms", "webNavigation", "system.cpu", "system.memory"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JackTrap",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["layer1_scan.js"],
      "run_at": "document_idle"
    }
  ]
}
